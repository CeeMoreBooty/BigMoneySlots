# ── keystore.properties ───────────────────────────────────────────────────────
# Copy this file to keystore.properties (same directory) and fill in your values.
# keystore.properties is listed in .gitignore — NEVER commit the real version.
#
# Generate the keystore with:
#   ./scripts/generate-keystore.sh
# ─────────────────────────────────────────────────────────────────────────────

# Absolute or relative path to your .jks file (relative to the app/ directory)
storeFile=../idledozer-release.jks

# The password you chose when creating the keystore
storePassword=YOUR_STORE_PASSWORD

# The alias you chose when creating the keystore
keyAlias=idledozer

# The password for the key itself (often the same as storePassword)
keyPassword=YOUR_KEY_PASSWORD
