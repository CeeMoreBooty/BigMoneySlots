<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ── Header card ───────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/gold" />

        <TextView
            android:id="@+id/tv_eps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00/sec"
            android:textSize="15sp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_boost_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/boost_color"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Action buttons ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_tap"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🚜 TAP TO EARN"
            android:textSize="13sp"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btn_watch_ad"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="⚡ Watch Ad\n2× Boost (60s)"
            android:textSize="11sp"
            android:backgroundTint="@color/boost_color" />

    </LinearLayout>

    <!-- ── Dozer shop ─────────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingBottom="4dp"
        android:text="DOZERS"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dozers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- ── Banner ad ──────────────────────────────────────────────────────── -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/banner_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

</LinearLayout>
