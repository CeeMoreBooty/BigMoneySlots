# Fastlane Fastfile — Idle Dozer
# https://docs.fastlane.tools/
#
# Prerequisites:
#   gem install bundler
#   bundle install
#
# Usage:
#   bundle exec fastlane [lane]
# ─────────────────────────────────────────────────────────────────────────────

default_platform(:android)

platform :android do

  # ── test ────────────────────────────────────────────────────────────────────
  # Run unit tests only (no device/emulator required).
  #
  # Usage:  bundle exec fastlane test
  #
  desc "Run unit tests"
  lane :test do
    gradle(task: "test")
  end

  # ── build_debug ─────────────────────────────────────────────────────────────
  # Build a debug APK for manual testing / sideloading.
  #
  # Usage:  bundle exec fastlane build_debug
  #
  desc "Build a debug APK"
  lane :build_debug do
    gradle(
      task:        "assemble",
      build_type:  "Debug"
    )
  end

  # ── build_release ───────────────────────────────────────────────────────────
  # Build a signed release AAB ready for upload to the Play Store.
  # Requires keystore.properties to be present (see keystore.properties.template).
  #
  # Usage:  bundle exec fastlane build_release
  #
  desc "Build a signed release AAB"
  lane :build_release do
    gradle(
      task:        "bundle",
      build_type:  "Release",
      print_command: false  # hide signing passwords from the console log
    )
  end

  # ── deploy_internal ─────────────────────────────────────────────────────────
  # Build + upload to the Internal Testing track on Google Play.
  # Requires:
  #   • keystore.properties (signing credentials)
  #   • fastlane/play-store-key.json (Google Play service-account JSON)
  #     OR set PLAY_STORE_JSON_KEY env var to the JSON key path.
  #
  # Usage:  bundle exec fastlane deploy_internal
  #
  desc "Build and deploy to Internal Testing track"
  lane :deploy_internal do
    build_release

    upload_to_play_store(
      track:              "internal",
      aab:                lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_apk:    true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # ── deploy_production ────────────────────────────────────────────────────────
  # Promote the current Internal build to Production.
  # Only run this after the build has passed Internal Testing review.
  #
  # Usage:  bundle exec fastlane deploy_production
  #
  desc "Promote Internal build to Production"
  lane :deploy_production do
    upload_to_play_store(
      track:        "internal",
      track_promote_to: "production",
      skip_upload_aab:  true,
      skip_upload_apk:  true
    )
  end

  # ── upload_metadata ──────────────────────────────────────────────────────────
  # Push store listing text (title, descriptions, changelog) to the Play Console
  # without uploading a new build.
  #
  # Usage:  bundle exec fastlane upload_metadata
  #
  desc "Upload store listing metadata only"
  lane :upload_metadata do
    upload_to_play_store(
      skip_upload_aab:         true,
      skip_upload_apk:         true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      metadata_path:           "../store-listing"
    )
  end

  # ── Error handler ────────────────────────────────────────────────────────────
  error do |lane, exception|
    UI.error "Lane '#{lane}' failed: #{exception.message}"
  end

end
