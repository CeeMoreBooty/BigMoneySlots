# ─── Server ───────────────────────────────────────────────
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/bigmoneyslots

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# ─── Google Play Billing ──────────────────────────────────
# Service account JSON key file path (downloaded from Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./config/google-service-account.json
# Your app's package name in Google Play
GOOGLE_PLAY_PACKAGE_NAME=com.yourstudio.bigmoneyslots
