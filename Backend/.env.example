# ─── Server ───────────────────────────────────────────────
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/bigmoneyslots

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# ─── Google Play Billing ──────────────────────────────────
# Service account JSON key file path (downloaded from Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./config/google-service-account.json
# Your app's package name in Google Play
GOOGLE_PLAY_PACKAGE_NAME=com.yourstudio.bigmoneyslots

# ─── PayPal ───────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# sandbox | live
PAYPAL_MODE=sandbox
# Full URL the app deep-links back to on success/cancel
PAYPAL_RETURN_URL=bigmoneyslots://paypal/success
PAYPAL_CANCEL_URL=bigmoneyslots://paypal/cancel

# ─── Stripe ───────────────────────────────────────────────
# Secret key  → used SERVER-SIDE to receive/process payments (NEVER expose publicly)
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_replace_with_your_new_key

# Publishable key → used CLIENT-SIDE in the checkout page (safe to expose)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_new_key

# Webhook secret → verifies that events came from Stripe (not a fake request)
# Get from: dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# ─── Owner / Business Email ────────────────────────────────
# Receives PayPal payments and e-transfer notifications
OWNER_EMAIL=tech.crew151@gmail.com

# ─── IP Logging ───────────────────────────────────────────
# Set to true to enable IP logging for fraud/security detection
IP_LOGGING_ENABLED=true

# ─── Security ─────────────────────────────────────────────
# Admin secret used to access /api/security/* endpoints
ADMIN_SECRET=change_this_to_a_long_random_string

# ─── Security Webhook ─────────────────────────────────────
# Forward security events and bans to your company server in real time.
# Your server verifies payloads using the X-BMS-Signature header (HMAC-SHA256).
# See Backend/services/webhookService.js for verification instructions.
SECURITY_WEBHOOK_ENABLED=true
SECURITY_WEBHOOK_URL=https://your-company-server.com/hooks/bigmoneyslots
SECURITY_WEBHOOK_SECRET=change_this_to_a_long_random_string
# Minimum severity to forward: low | medium | high | critical  (default: medium)
SECURITY_WEBHOOK_MIN_SEVERITY=medium

# ─── Discord Admin Webhook ─────────────────────────────────────────────────────
# Sends real-time admin notifications (bans, fraud, purchases, server start)
# to your Discord server via an Incoming Webhook.
# Setup: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# !! NEVER commit the actual webhook URL to source control !!
ADMIN_DISCORD_WEBHOOK_ENABLED=true
ADMIN_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

