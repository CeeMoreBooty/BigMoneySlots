# ═══════════════════════════════════════════════════════════
# Railway Deployment Environment Variables Template
# ═══════════════════════════════════════════════════════════
#
# Configure these in your Railway dashboard under:
# Project → Service → Variables
#
# Railway automatically provides: $PORT, $RAILWAY_ENVIRONMENT
# ═══════════════════════════════════════════════════════════

# ─── Server (Railway auto-provides PORT) ─────────────────
# PORT is automatically set by Railway - no need to configure
# Railway assigns a random port and maps it to your service

# ─── MongoDB ──────────────────────────────────────────────
# Option 1: Railway MongoDB Plugin (Recommended)
# Add MongoDB plugin in Railway dashboard, it auto-configures MONGO_URL
# Railway will set: MONGO_URL=mongodb://...
#
# Option 2: MongoDB Atlas (External)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bigmoneyslots?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_long_random_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=30d

# ─── Google Play Billing ──────────────────────────────────
# For Railway, store the JSON key as a base64-encoded variable:
# 1. Base64 encode: cat google-service-account.json | base64
# 2. Set in Railway: GOOGLE_SERVICE_ACCOUNT_BASE64=<encoded_value>
# 3. App will decode it at runtime
GOOGLE_PLAY_PACKAGE_NAME=com.bigmoneyslots.app

# ─── PayPal ───────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=bigmoneyslots://paypal/success
PAYPAL_CANCEL_URL=bigmoneyslots://paypal/cancel

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_or_sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── Owner Email ──────────────────────────────────────────
OWNER_EMAIL=your-email@example.com

# ─── IP Logging ───────────────────────────────────────────
IP_LOGGING_ENABLED=true

# ─── Security ─────────────────────────────────────────────
ADMIN_SECRET=your_long_random_admin_secret_here
SECURITY_WEBHOOK_ENABLED=false
SECURITY_WEBHOOK_URL=https://your-webhook-receiver.com/hooks
SECURITY_WEBHOOK_SECRET=your_webhook_secret
SECURITY_WEBHOOK_MIN_SEVERITY=medium

# ─── Railway Specific ─────────────────────────────────────
# NODE_ENV is automatically set by Railway
# NODE_ENV=production

# ─── CORS (Optional) ──────────────────────────────────────
# If you need to restrict CORS, add your Unity app URLs
# ALLOWED_ORIGINS=https://your-game-domain.com
