# BigMoneySlots — Environment Variables

# ─── Railway / Backend ───────────────────────────────────────────────────────
# MongoDB connection string (Railway sets MONGO_URL automatically)
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/bigmoneyslots

# JWT secret (generate a long random string)
# JWT_SECRET=replace_with_a_long_random_secret

# Token expiry
# JWT_EXPIRES=7d

# Port (Railway sets PORT automatically)
# PORT=3000
